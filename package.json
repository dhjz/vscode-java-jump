{
  "name": "java-jump",
  "displayName": "Java Jump",
  "description": "Java code navigation for VS Code",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:java",
    "onLanguage:xml"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": []
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "build": "powershell -ExecutionPolicy Bypass -File scripts/build.ps1"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.85.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0"
  }
}
